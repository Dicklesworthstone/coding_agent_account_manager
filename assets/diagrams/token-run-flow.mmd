%%{init: {"theme": "base", "htmlLabels": false,
  "flowchart": {"htmlLabels": false, "wrappingWidth": 320, "padding": 25, "diagramPadding": 24, "nodeSpacing": 60, "rankSpacing": 60},
  "themeVariables": {
  "primaryColor": "#fcfcfb",
  "primaryBorderColor": "#c3c2b7",
  "primaryTextColor": "#0b0b0b",
  "lineColor": "#898781",
  "fontFamily": "system-ui"
}}}%%
flowchart TD
    A["caam run claude"] --> B{"default token profile set?"}
    B -->|no| FS["file-swap path"]
    B -->|yes| C{"profile in cooldown?"}
    C -->|yes| D["rotate to another token profile"]
    C -->|no| E["read token file and meta.json"]
    D --> E
    E --> S["scrub ambient auth env vars"]
    FS --> S
    S --> I1["inject CLAUDE_CODE_OAUTH_TOKEN"]
    I1 --> I2["set per-profile CLAUDE_CONFIG_DIR"]
    I2 --> H["spawn claude child in PTY"]
    S --> H

    classDef accent fill:#d6f1e6,stroke:#1baf7a,color:#0b0b0b
    class I1,I2 accent
