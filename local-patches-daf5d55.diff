+func TestRun_UseGlobalEnvScrubsProviderAuthEnv(t *testing.T) {
+	tmpDir := t.TempDir()
+	prof := &profile.Profile{
+		Name:     "test",
+		Provider: "claude",
+		BasePath: tmpDir,
+	}
+
+	if err := os.MkdirAll(prof.BasePath, 0700); err != nil {
+		t.Fatalf("Failed to create profile dir: %v", err)
+	}
+
+	oldAnthropic := os.Getenv("ANTHROPIC_API_KEY")
+	t.Cleanup(func() {
+		if oldAnthropic == "" {
+			_ = os.Unsetenv("ANTHROPIC_API_KEY")
+			return
+		}
+		_ = os.Setenv("ANTHROPIC_API_KEY", oldAnthropic)
+	})
+	if err := os.Setenv("ANTHROPIC_API_KEY", "shared-key"); err != nil {
+		t.Fatalf("Setenv() error = %v", err)
+	}
+
+	mock := &mockProvider{
+		id:         "claude",
+		defaultBin: "sh",
+		envVars:    map[string]string{},
+	}
+
+	registry := provider.NewRegistry()
+	runner := NewRunner(registry)
+
+	err := runner.Run(context.Background(), RunOptions{
+		Profile:      prof,
+		Provider:     mock,
+		Args:         []string{"-c", `test -z "${ANTHROPIC_API_KEY:-}"`},
+		NoLock:       true,
+		UseGlobalEnv: true,
+	})
+	if err != nil {
+		t.Fatalf("Run() error = %v", err)
+	}
+}
